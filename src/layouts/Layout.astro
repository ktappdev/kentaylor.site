---
import Analytics from '@vercel/analytics/astro';
import SeoHead from '../components/SEO/SeoHead.astro';
import '../styles/global.css';
import type { JsonLd } from '../lib/structured-data';
import { SITE } from '../lib/site';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  image?: {
    src: string;
    alt?: string;
    width?: number;
    height?: number;
    type?: string;
  };
  keywords?: string[];
  robots?: string;
  type?: 'website' | 'article';
  publishedTime?: string;
  modifiedTime?: string;
  articleTags?: string[];
  authorUrl?: string;
  jsonLd?: JsonLd | JsonLd[];
}

const {
  title = SITE.defaultTitle,
  description = SITE.defaultDescription,
  canonical,
  image,
  keywords = [],
  robots,
  type = 'website',
  publishedTime,
  modifiedTime,
  articleTags = [],
  authorUrl = SITE.aboutPath,
  jsonLd,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <SeoHead
      title={title}
      description={description}
      canonical={canonical}
      image={image}
      keywords={keywords}
      robots={robots}
      type={type}
      publishedTime={publishedTime}
      modifiedTime={modifiedTime}
      articleTags={articleTags}
      authorUrl={authorUrl}
      jsonLd={jsonLd}
    />
    
    <!-- Geo tags for Guyana -->
    <meta name="geo.region" content="GY" />
    <meta name="geo.placename" content="Georgetown, Guyana" />
    <meta name="geo.position" content="6.8013;-58.1551" />
    <meta name="ICBM" content="6.8013, -58.1551" />
    
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet" />
    
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    
    <slot name="head" />
    
    <title>{title}</title>
    <Analytics />
  </head>
  <body class="noise-bg min-h-screen">
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-[9999] focus:px-4 focus:py-2 focus:bg-accent focus:text-bg focus:font-mono focus:text-sm focus:rounded"
    >
      Skip to main content
    </a>
    <slot />
  </body>
</html>
