---
import Analytics from '@vercel/analytics/astro';
import SeoHead from '../components/SEO/SeoHead.astro';
import '../styles/global.css';
import type { JsonLd } from '../lib/structured-data';
import { SITE } from '../lib/site';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  image?: {
    src: string;
    alt?: string;
    width?: number;
    height?: number;
    type?: string;
  };
  keywords?: string[];
  robots?: string;
  type?: 'website' | 'article';
  publishedTime?: string;
  modifiedTime?: string;
  articleTags?: string[];
  authorUrl?: string;
  jsonLd?: JsonLd | JsonLd[];
}

const {
  title = SITE.defaultTitle,
  description = SITE.defaultDescription,
  canonical,
  image,
  keywords = [],
  robots,
  type = 'website',
  publishedTime,
  modifiedTime,
  articleTags = [],
  authorUrl = SITE.aboutPath,
  jsonLd,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <SeoHead
      title={title}
      description={description}
      canonical={canonical}
      image={image}
      keywords={keywords}
      robots={robots}
      type={type}
      publishedTime={publishedTime}
      modifiedTime={modifiedTime}
      articleTags={articleTags}
      authorUrl={authorUrl}
      jsonLd={jsonLd}
    />
    
    <!-- Geo tags for Guyana -->
    <meta name="geo.region" content="GY" />
    <meta name="geo.placename" content="Georgetown, Guyana" />
    <meta name="geo.position" content="6.8013;-58.1551" />
    <meta name="ICBM" content="6.8013, -58.1551" />
    
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet" />
    
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    
    <slot name="head" />
    
    <title>{title}</title>
    <Analytics />
  </head>
  <body class="noise-bg min-h-screen">
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-[9999] focus:px-4 focus:py-2 focus:bg-accent focus:text-bg focus:font-mono focus:text-sm focus:rounded"
    >
      Skip to main content
    </a>
    <slot />
    
    <script define:vars={{}}>
      function initCursor() {
        if (document.querySelector('.custom-cursor')) return;
        
        const cursor = document.createElement('div');
        cursor.className = 'custom-cursor';
        cursor.innerHTML = '<div class="cursor-dot"></div><div class="cursor-ring"></div>';
        document.body.appendChild(cursor);
        
        let mouseX = 0;
        let mouseY = 0;
        let cursorX = 0;
        let cursorY = 0;
        
        document.addEventListener('mousemove', (e) => {
          mouseX = e.clientX;
          mouseY = e.clientY;
        });
        
        function animateCursor() {
          cursorX += (mouseX - cursorX) * 0.15;
          cursorY += (mouseY - cursorY) * 0.15;
          
          const dot = cursor.querySelector('.cursor-dot');
          const ring = cursor.querySelector('.cursor-ring');
          
          if (dot instanceof HTMLElement) {
            dot.style.transform = `translate(${mouseX}px, ${mouseY}px)`;
          }
          if (ring instanceof HTMLElement) {
            ring.style.transform = `translate(${cursorX}px, ${cursorY}px)`;
          }
          
          requestAnimationFrame(animateCursor);
        }
        
        animateCursor();
        
        const interactiveElements = document.querySelectorAll('a, button, [data-cursor]');
        interactiveElements.forEach((el) => {
          el.addEventListener('mouseenter', () => {
            cursor.classList.add('cursor-hover');
          });
          el.addEventListener('mouseleave', () => {
            cursor.classList.remove('cursor-hover');
          });
        });
      }
      
      document.addEventListener('DOMContentLoaded', initCursor);
      document.addEventListener('astro:page-load', initCursor);
    </script>
    
    <style is:global>
      .custom-cursor {
        pointer-events: none;
        position: fixed;
        top: 0;
        left: 0;
        z-index: 9999;
      }
      
      .cursor-dot {
        width: 8px;
        height: 8px;
        background: #00ff88;
        border-radius: 50%;
        position: absolute;
        transform: translate(-50%, -50%);
        transition: width 0.2s, height 0.2s, background 0.2s;
        box-shadow: 0 0 10px #00ff88, 0 0 20px rgba(0, 255, 136, 0.5);
      }
      
      .cursor-ring {
        width: 40px;
        height: 40px;
        border: 2px solid #00ff88;
        border-radius: 50%;
        position: absolute;
        transform: translate(-50%, -50%);
        transition: width 0.3s, height 0.3s, border 0.3s;
      }
      
      .cursor-hover .cursor-dot {
        width: 12px;
        height: 12px;
        background: #ffffff;
        box-shadow: 0 0 15px #ffffff, 0 0 30px rgba(255, 255, 255, 0.5);
      }
      
      .cursor-hover .cursor-ring {
        width: 60px;
        height: 60px;
        border: 2px solid #ffffff;
      }
      
      @media (max-width: 768px) {
        .custom-cursor {
          display: none;
        }
      }
      
      html {
        cursor: none;
      }
      
      @media (max-width: 768px) {
        html {
          cursor: auto;
        }
      }
    </style>
  </body>
</html>
