---
import Layout from '../../layouts/Layout.astro';
import Navigation from '../../components/UI/Navigation';
import Footer from '../../components/UI/Footer';
import BlogCard from '../../components/Blog/BlogCard';
import NewsletterEmbed from '../../components/Blog/NewsletterEmbed';
import Breadcrumbs from '../../components/Blog/Breadcrumbs.astro';
import { getPublishedBlogPosts, getTagCounts } from '../../lib/blog';
import { getTagUrl } from '../../lib/tags';
import {
  buildBlogIndexSchemas,
  buildBreadcrumbSchema,
} from '../../lib/structured-data';

const sortedPosts = await getPublishedBlogPosts();
const tagCounts = await getTagCounts();
const pageTitle = 'Blog | Ken Taylor';
const pageDescription =
  'Articles and insights on tech, software, entrepreneurship, and building from Guyana.';
const jsonLd = [
  ...buildBlogIndexSchemas(sortedPosts),
  buildBreadcrumbSchema([
    { name: 'Home', path: '/' },
    { name: 'Blog', path: '/blog/' },
  ]),
];

const BEEHIIV_EMBED_CODE = `<script async src="https://subscribe-forms.beehiiv.com/embed.js"></script><iframe src="https://subscribe-forms.beehiiv.com/89cd1477-b789-4179-a28d-bf2dc93d7028" class="beehiiv-embed" data-test-id="beehiiv-embed" frameborder="0" scrolling="no" style="width: 100%; height: 315px; margin: 0; border-radius: 0px; background-color: transparent; max-width: 100%;"></iframe>`;
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonical="/blog/"
  keywords={[
    'ken taylor blog',
    'guyana developer blog',
    'caribbean tech blog',
    'astro blog',
  ]}
  jsonLd={jsonLd}
>
  <Navigation client:load transition:persist />
  
  <main id="main-content" class="pt-24 pb-16 min-h-screen">
    <div class="max-w-4xl mx-auto px-6">
      <Breadcrumbs
        items={[
          { label: 'Home', href: '/' },
          { label: 'Blog' },
        ]}
      />
      <h1 class="text-5xl md:text-6xl font-bold mb-4">
        <span class="text-accent">#</span> Blog
      </h1>
      <p class="text-muted text-lg mb-12">
        Essays on software, entrepreneurship, and building useful things
        from Guyana.
      </p>

      {tagCounts.length > 0 && (
        <nav class="mb-12" aria-label="Browse blog posts by topic">
          <h2 class="text-sm font-mono text-muted uppercase tracking-wider mb-4">
            Browse by topic
          </h2>
          <ul class="flex flex-wrap gap-2">
            {tagCounts.map(({ tag, count }) => (
              <li>
                <a
                  href={getTagUrl(tag)}
                  class="inline-flex items-center gap-2 px-3 py-1.5 bg-surface border border-border rounded font-mono text-sm text-muted hover:text-accent hover:border-accent/50 transition-colors"
                >
                  <span>#{tag}</span>
                  <span class="text-xs text-muted/70">{count}</span>
                </a>
              </li>
            ))}
          </ul>
        </nav>
      )}

      <div class="space-y-6">
        {sortedPosts.map((post, index) => (
          <BlogCard post={post} index={index} client:visible />
        ))}
      </div>

      <section class="mt-20 pt-12 border-t border-border">
        <div class="mb-8 flex flex-wrap items-center justify-between gap-4">
          <div>
            <h2 class="text-2xl font-bold">Stay Updated</h2>
            <p class="mt-2 text-muted">
              Subscribe by email or use the RSS feed for automatic updates.
            </p>
          </div>
          <a
            href="/rss.xml"
            class="font-mono text-sm text-accent transition-colors hover:text-text"
          >
            Open RSS Feed
          </a>
        </div>
        <NewsletterEmbed embedCode={BEEHIIV_EMBED_CODE} client:visible />
      </section>
    </div>
  </main>
  
  <Footer client:visible />
</Layout>
