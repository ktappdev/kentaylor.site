---
import Layout from '../../layouts/Layout.astro';
import Navigation from '../../components/UI/Navigation';
import Footer from '../../components/UI/Footer';
import type { InferGetStaticPropsType, GetStaticPaths } from 'astro';
import { getCollection } from 'astro:content';

export const getStaticPaths = (async () => {
  const blogPosts = await getCollection('blog');
  return blogPosts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { post } = Astro.props as Props;
const { Content } = await post.render();

const formatDate = (date: Date) => {
  return new Intl.DateTimeFormat('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  }).format(date);
};

const pageTitle = `${post.data.title} | Ken Taylor - Guyanese Developer & Music Producer`;
const pageDescription = `${post.data.excerpt} Written by Ken Taylor, co-founder of Lugetech from Georgetown, Guyana.`;
const pageImage = post.data.image || '/og-image.svg';
---

<Layout title={pageTitle} description={pageDescription}>
  <Fragment slot="head">
    <meta property="og:type" content="article" />
    <meta property="article:published_time" content={post.data.date.toISOString()} />
    <meta property="article:author" content="Ken Taylor" />
    {post.data.tags.map((tag: string) => (
      <meta property="article:tag" content={tag} />
    ))}
    <meta property="og:image" content={`${Astro.site}${pageImage}`} />
    <meta name="twitter:image" content={`${Astro.site}${pageImage}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="keywords" content={`${post.data.tags.join(', ')}, Guyana, Guyanese, Georgetown, Caribbean, tech, developer`} />
  </Fragment>
  <style>
    .blog-content {
      line-height: 1.8;
    }
    .blog-content :where(h1, h2, h3, h4) {
      font-family: 'JetBrains Mono', monospace !important;
      font-weight: 700 !important;
      margin-top: 2.5rem !important;
      margin-bottom: 0 !important;
      color: #fafafa !important;
    }
    .blog-content :where(h2) {
      font-size: 1.75rem !important;
      margin-top: 3rem !important;
      margin-bottom: 0 !important;
    }
    .blog-content :where(h3) {
      font-size: 1.25rem !important;
      margin-top: 2rem !important;
      margin-bottom: 0 !important;
    }
    .blog-content :where(h2) + p,
    .blog-content :where(h3) + p,
    .blog-content :where(h4) + p {
      margin-top: 0.5rem !important;
    }
    .blog-content :where(p) {
      margin-bottom: 1.25rem !important;
      color: #737373 !important;
    }
    .blog-content ul,
    .blog-content ol {
      margin-bottom: 1.5rem;
      padding-left: 1.5rem;
      color: #737373;
    }
    .blog-content li {
      margin-bottom: 0.5rem;
    }
    .blog-content li::marker {
      color: #00ff88;
    }
    .blog-content a {
      color: #00ff88;
      text-decoration: none;
    }
    .blog-content a:hover {
      text-decoration: underline;
    }
    .blog-content code {
      color: #00ff88;
      background: #141414;
      padding: 0.2rem 0.4rem;
      border-radius: 0.25rem;
      font-family: 'JetBrains Mono', monospace;
    }
    .blog-content pre {
      background: #141414;
      border: 1px solid #262626;
      border-radius: 0.5rem;
      padding: 1rem;
      margin-bottom: 1.5rem;
      overflow-x: auto;
    }
    .blog-content pre code {
      background: transparent;
      padding: 0;
    }
    .blog-content strong {
      color: #fafafa;
    }
  </style>
  <Navigation client:load />
  
  <article class="pt-24 pb-16 min-h-screen">
    <div class="max-w-3xl mx-auto px-6">
      <header class="mb-12">
        <div class="flex items-center gap-3 mb-4 text-sm text-muted font-mono">
          <time datetime={post.data.date.toString()}>
            {formatDate(post.data.date)}
          </time>
          <span>•</span>
          <span>5 min read</span>
        </div>
        
        <h1 class="text-4xl md:text-5xl font-bold mb-4">
          {post.data.title}
        </h1>
        
        <p class="text-xl text-muted mb-6">
          {post.data.excerpt}
        </p>
        
        <div class="flex flex-wrap gap-2">
          {post.data.tags.map((tag: string) => (
            <span class="px-3 py-1 text-sm font-mono text-accent bg-accent/10 rounded">
              #{tag}
            </span>
          ))}
        </div>
      </header>
      
      <div class="blog-content prose prose-invert max-w-none">
        <Content />
      </div>
      
      <footer class="mt-16 pt-8 border-t border-border">
        <a
          href="/blog"
          class="inline-flex items-center gap-2 text-muted hover:text-accent transition-colors font-mono"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16l-4-4m0 0l4-4m-4 4h18" />
          </svg>
          Back to Blog
        </a>
      </footer>
    </div>
  </article>
  
  <Footer client:visible />
</Layout>
