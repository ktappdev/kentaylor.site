---
import Layout from '../../layouts/Layout.astro';
import Navigation from '../../components/UI/Navigation';
import Footer from '../../components/UI/Footer';
import NewsletterEmbed from '../../components/Blog/NewsletterEmbed';
import Breadcrumbs from '../../components/Blog/Breadcrumbs.astro';
import AuthorCard from '../../components/Blog/AuthorCard.astro';
import PostPager from '../../components/Blog/PostPager.astro';
import RelatedPosts from '../../components/Blog/RelatedPosts';
import type { InferGetStaticPropsType, GetStaticPaths } from 'astro';
import { Image } from 'astro:assets';
import {
  getPostCoverImage,
  getPostImageAlt,
  getPostReadingTimeLabel,
  getPostSeoDescription,
  getPostSeoTitle,
  getPostUpdatedDate,
  getPostUrl,
  getPublishedBlogPosts,
} from '../../lib/blog';
import {
  buildBlogPostingSchemas,
  buildBreadcrumbSchema,
} from '../../lib/structured-data';

const BEEHIIV_EMBED_CODE = `<script async src="https://subscribe-forms.beehiiv.com/embed.js"></script><iframe src="https://subscribe-forms.beehiiv.com/89cd1477-b789-4179-a28d-bf2dc93d7028" class="beehiiv-embed" data-test-id="beehiiv-embed" frameborder="0" scrolling="no" style="width: 100%; height: 315px; margin: 0; border-radius: 0px; background-color: transparent; max-width: 100%;"></iframe>`;

import { getPublishedBlogPosts } from '../../lib/blog';
import type { InferGetStaticPropsType, GetStaticPaths } from 'astro';

export const getStaticPaths = (async () => {
  const blogPosts = await getPublishedBlogPosts();
  return blogPosts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { post } = Astro.props as Props;
const { Content, headings } = await post.render();
const allPosts = await getPublishedBlogPosts();
const currentIndex = allPosts.findIndex((entry) => entry.slug === post.slug);
const newerPost = currentIndex > 0 ? allPosts[currentIndex - 1] : null;
const olderPost =
  currentIndex >= 0 && currentIndex < allPosts.length - 1
    ? allPosts[currentIndex + 1]
    : null;

const currentTags = post.data.tags;
const relatedPosts = allPosts
  .filter(p => p.slug !== post.slug && p.data.tags.some(tag => currentTags.includes(tag)))
  .slice(0, 2);

const tocItems = headings
  .filter(h => h.depth >= 2 && h.depth <= 3)
  .map(h => ({
    id: h.slug,
    text: h.text,
    level: h.depth,
  }));

const formatDate = (date: Date) => {
  return new Intl.DateTimeFormat('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  }).format(date);
};

const pageTitle = getPostSeoTitle(post);
const pageDescription = getPostSeoDescription(post);
const pageImage = getPostCoverImage(post);
const pageImageAlt = getPostImageAlt(post);
const pageKeywords = [
  ...post.data.tags,
  'Ken Taylor',
  'Guyanese developer',
  'Guyana tech',
];
const readingTimeLabel = getPostReadingTimeLabel(post);
const publishedTime = post.data.date.toISOString();
const modifiedTime = getPostUpdatedDate(post).toISOString();
const jsonLd = [
  ...buildBlogPostingSchemas(post),
  buildBreadcrumbSchema([
    { name: 'Home', path: '/' },
    { name: 'Blog', path: '/blog/' },
    { name: post.data.title, path: getPostUrl(post) },
  ]),
];
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonical={getPostUrl(post)}
  type="article"
  image={{
    src: pageImage,
    alt: pageImageAlt,
    width: 1200,
    height: 630,
    type: pageImage.endsWith('.jpg') || pageImage.endsWith('.jpeg')
      ? 'image/jpeg'
      : pageImage.endsWith('.png')
        ? 'image/png'
        : undefined,
  }}
  keywords={pageKeywords}
  publishedTime={publishedTime}
  modifiedTime={modifiedTime}
  articleTags={post.data.tags}
  jsonLd={jsonLd}
>
  <style>
    .blog-content {
      line-height: 1.8;
    }
    .blog-content :where(h1, h2, h3, h4) {
      font-family: 'JetBrains Mono', monospace !important;
      font-weight: 700 !important;
      margin-top: 2.5rem !important;
      margin-bottom: 0 !important;
      color: #fafafa !important;
    }
    .blog-content :where(h2) {
      font-size: 1.75rem !important;
      margin-top: 3rem !important;
      margin-bottom: 0 !important;
    }
    .blog-content :where(h3) {
      font-size: 1.25rem !important;
      margin-top: 2rem !important;
      margin-bottom: 0 !important;
    }
    .blog-content :where(h2) + p,
    .blog-content :where(h3) + p,
    .blog-content :where(h4) + p {
      margin-top: 0.5rem !important;
    }
    .blog-content :where(p) {
      margin-bottom: 1.25rem !important;
      color: #737373 !important;
    }
    .blog-content ul,
    .blog-content ol {
      margin-bottom: 1.5rem;
      padding-left: 1.5rem;
      color: #737373;
    }
    .blog-content li {
      margin-bottom: 0.5rem;
    }
    .blog-content li::marker {
      color: #00ff88;
    }
    .blog-content a {
      color: #00ff88;
      text-decoration: none;
    }
    .blog-content a:hover {
      text-decoration: underline;
    }
    .blog-content code {
      color: #00ff88;
      background: #141414;
      padding: 0.2rem 0.4rem;
      border-radius: 0.25rem;
      font-family: 'JetBrains Mono', monospace;
    }
    .blog-content pre {
      background: #141414;
      border: 1px solid #262626;
      border-radius: 0.5rem;
      padding: 1rem;
      margin-bottom: 1.5rem;
      overflow-x: auto;
    }
    .blog-content pre code {
      background: transparent;
      padding: 0;
    }
    .blog-content strong {
      color: #fafafa;
    }
    .blog-content :where(h2, h3, h4) {
      scroll-margin-top: 6rem;
    }
  </style>
  <Navigation client:load />
  
  <div class="relative">
    <div id="progress-bar" class="fixed top-0 left-0 h-1 bg-accent z-[100]" style="width: 0%"></div>
    
    {tocItems.length > 0 && (
      <nav class="hidden xl:block fixed right-8 top-32 w-64 z-50">
        <h4 class="text-sm font-mono text-muted uppercase tracking-wider mb-4">
          On This Page
        </h4>
        <ul class="space-y-2 text-sm">
          {tocItems.map((item) => (
            <li key={item.id}>
              <a
                href={`#${item.id}`}
                class={`text-muted hover:text-accent transition-colors ${
                  item.level === 3 ? 'pl-4' : ''
                }`}
              >
                {item.text}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    )}
    
    <article id="main-content" class="pt-24 pb-16 min-h-screen">
    <div class="max-w-3xl mx-auto px-6">
      <Breadcrumbs
        items={[
          { label: 'Home', href: '/' },
          { label: 'Blog', href: '/blog/' },
          { label: post.data.title },
        ]}
      />
      <header class="mb-12">
        <div class="flex items-center gap-3 mb-4 text-sm text-muted font-mono">
          <time datetime={publishedTime}>
            {formatDate(post.data.date)}
          </time>
          <span>•</span>
          <span>{readingTimeLabel}</span>
        </div>
        
        <h1 class="text-4xl md:text-5xl font-bold mb-4">
          {post.data.title}
        </h1>
        
        <p class="text-xl text-muted mb-6">
          {post.data.excerpt}
        </p>
        
        <div class="flex flex-wrap gap-2">
          {post.data.tags.map((tag: string) => (
            <a
              key={tag}
              href={`/blog/tag/${tag.toLowerCase().replace(/\s+/g, '-')}/`}
              class="px-3 py-1 text-sm font-mono text-accent bg-accent/10 rounded hover:bg-accent/20 transition-colors"
            >
              #{tag}
            </a>
          ))}
        </div>
      </header>
      
      {pageImage && (
        <div class="mb-12 -mx-6 md:-mx-12">
          <Image 
            src={pageImage} 
            alt={pageImageAlt}
            class="w-full h-auto rounded-lg shadow-lg"
            width="1200"
            height="630"
            loading="lazy"
            decoding="async"
          />
        </div>
      )}
      
      <div class="blog-content prose prose-invert max-w-none">
        <Content />
      </div>

      <AuthorCard />

      <PostPager newerPost={newerPost} olderPost={olderPost} />
      
      <RelatedPosts posts={relatedPosts} client:visible />
      
      <section class="mt-16 pt-8 border-t border-border">
        <NewsletterEmbed embedCode={BEEHIIV_EMBED_CODE} client:visible />
      </section>
      
      <footer class="mt-12 pt-8 border-t border-border">
        <a
          href="/blog/"
          class="inline-flex items-center gap-2 text-muted hover:text-accent transition-colors font-mono"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16l-4-4m0 0l4-4m-4 4h18" />
          </svg>
          Back to Blog
        </a>
      </footer>
    </div>
    </article>
  </div>
  
  <Footer client:visible />
  
  <script>
    function initProgressBar() {
      const progressBar = document.getElementById('progress-bar');
      if (!progressBar) return;
      
      function updateProgress() {
        const article = document.getElementById('main-content');
        if (!article) return;
        
        const rect = article.getBoundingClientRect();
        const viewportHeight = window.innerHeight;
        const articleTop = rect.top;
        const articleHeight = rect.height;
        
        const scrollProgress = viewportHeight - articleTop;
        const maxProgress = articleHeight - viewportHeight;
        const percentage = Math.min(100, Math.max(0, (scrollProgress / maxProgress) * 100));
        
        progressBar.style.width = `${percentage}%`;
      }
      
      window.addEventListener('scroll', updateProgress);
      window.addEventListener('resize', updateProgress);
      updateProgress();
    }
    
    document.addEventListener('DOMContentLoaded', initProgressBar);
  </script>
</Layout>
