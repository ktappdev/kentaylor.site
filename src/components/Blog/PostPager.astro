---
import {
  getPostReadingTimeLabel,
  getPostUrl,
  type BlogPost,
} from "../../lib/blog";

interface Props {
  newerPost?: BlogPost | null;
  olderPost?: BlogPost | null;
}

const { newerPost = null, olderPost = null } = Astro.props;
const links = [
  newerPost ? { label: "Newer Post", post: newerPost } : null,
  olderPost ? { label: "Older Post", post: olderPost } : null,
].filter(Boolean) as Array<{ label: string; post: BlogPost }>;
---

{links.length > 0 && (
  <nav aria-label="More posts" class="mt-12 grid gap-4 md:grid-cols-2">
    {links.map(({ label, post }) => (
      <a
        href={getPostUrl(post)}
        class="rounded-2xl border border-border bg-surface/50 p-5 transition-colors hover:border-accent/50"
      >
        <p class="font-mono text-xs uppercase tracking-[0.2em] text-accent">
          {label}
        </p>
        <h2 class="mt-3 text-xl font-bold">{post.data.title}</h2>
        <p class="mt-2 text-sm text-muted">{post.data.excerpt}</p>
        <p class="mt-4 font-mono text-xs text-muted">
          {getPostReadingTimeLabel(post)}
        </p>
      </a>
    ))}
  </nav>
)}
